# ---- Server ----
NODE_ENV=development
PORT=5000
HTTPS_PORT=5443
USE_HTTPS=true

# ---- Authentication ----
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace_this_with_a_long_random_string_before_running
JWT_EXPIRES_IN=1h

# ---- CORS (comma-separated list of allowed frontend origins) ----
CORS_ORIGIN=https://localhost:3000

# ---- TLS (created by "npm run gen-cert") ----
SSL_KEY_PATH=certs/key.pem
SSL_CERT_PATH=certs/cert.pem

# ---- Database ----
# Local MongoDB:   mongodb://127.0.0.1:27017/hustlehub
# MongoDB Atlas:   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/hustlehub
MONGODB_URI=mongodb://127.0.0.1:27017/hustlehub
# Optional: separate database used by "npm run test:api" (defaults to hustlehub_test on the same server)
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017/hustlehub_test

# ---- Rate limiting (defaults shown) ----
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_AUTH_MAX=20
RATE_LIMIT_BOOKING_MAX=10
RATE_LIMIT_API_MAX=300
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_OTP_MAX=8

# ---- Admin seeding (used only by "npm run seed:admin") ----
# Admin accounts can NOT be created through public registration.
ADMIN_NAME=Platform Admin
ADMIN_EMAIL=admin@hustlehub.local
ADMIN_PASSWORD=change_me_to_a_strong_password_12+

# ---- Two-factor authentication (email codes) ----
# Optional: leave blank to run in demo mode (codes are logged to this console and returned
# in the API response so 2FA can be tested without a mail account). Fill these in to send real
# emails, e.g. with a Gmail app password (myaccount.google.com/apppasswords), SendGrid, or
# Mailtrap for testing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=HustleHub+ <no-reply@hustlehub.local>
TWO_FACTOR_TOKEN_EXPIRES_IN=10m

# ---- Payments ----
# Payments are simulated: booking a gig collects demo card details in the browser (never sent
# anywhere, never validated against a real card network) and confirms instantly. No payment
# provider account or API key is needed to run this project.
